import asyncio, sys
from playwright.async_api import async_playwright
sys.stdout.reconfigure(encoding="utf-8")

URL = "http://linar.me/holodok/"
OUT = r"G:\SlavaSaitOffer\site"

SECTIONS = [
    ("footer", "footer"),
    ("masters", ".t74-masters, [class*=masters]"),
    ("brands", ".t74-brands, [class*=brands]"),
    ("geo", ".t74-geo, [class*=geo]"),
    ("map", "#map"),
    ("search", ".t74-search"),
    ("reviews", "[class*=rev]"),
]

async def main():
    errs = []
    async with async_playwright() as p:
        b = await p.chromium.launch()
        pg = await b.new_page(viewport={"width": 1440, "height": 900})
        pg.on("pageerror", lambda e: errs.append(str(e)))
        await pg.goto(URL, wait_until="domcontentloaded", timeout=60000)
        await pg.wait_for_timeout(3000)
        # пролистать, чтобы ленивые картинки встали
        H = await pg.evaluate("document.body.scrollHeight")
        for i in range(1, 11):
            await pg.evaluate(f"window.scrollTo(0, document.body.scrollHeight*{i/10})")
            await pg.wait_for_timeout(350)
        await pg.wait_for_timeout(1500)

        print("ВЫСОТА СТРАНИЦЫ:", H)
        print("--- размеры блоков ---")
        for name, sel in SECTIONS:
            try:
                r = await pg.evaluate(
                    "s=>{const e=document.querySelector(s); if(!e) return null;"
                    "const b=e.getBoundingClientRect(); return [Math.round(b.width),Math.round(b.height),Math.round(b.top+window.scrollY)]}",
                    sel)
                print(f"  {name:10s} {r}")
            except Exception as e:
                print(f"  {name:10s} ERR {e}")

        print("--- снимки по прокрутке ---")
        for i, frac in enumerate([0.0, 0.18, 0.36, 0.55, 0.72, 0.88, 1.0]):
            await pg.evaluate(f"window.scrollTo(0, document.body.scrollHeight*{frac})")
            await pg.wait_for_timeout(700)
            await pg.screenshot(path=f"{OUT}\\qa_{i}.png")
        print("ERRORS:", len(errs))
        for e in errs[:6]:
            print("  ", e[:150])
        await b.close()

asyncio.run(main())
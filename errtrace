import asyncio, sys
from playwright.async_api import async_playwright
sys.stdout.reconfigure(encoding="utf-8")

URL = "http://127.0.0.1:8125/index.html"

async def main():
    errs = []
    async with async_playwright() as p:
        b = await p.chromium.launch()
        pg = await b.new_page(viewport={"width": 1440, "height": 900})
        def on_err(e):
            stack = getattr(e, "stack", None) or str(e)
            errs.append(stack + "\nMSG: " + str(getattr(e, "message", "")))
        pg.on("pageerror", on_err)
        await pg.goto(URL, wait_until="load", timeout=60000)
        await pg.wait_for_timeout(3000)
        # поскроллить, чтобы отработали ленивые инициализации
        for x in (0.25, 0.5, 0.75, 1.0):
            await pg.evaluate(f"window.scrollTo(0, document.body.scrollHeight*{x})")
            await pg.wait_for_timeout(700)
        await pg.evaluate("window.scrollTo(0,0)")
        await pg.wait_for_timeout(500)
        await b.close()
    print("ERRORS:", len(errs))
    for i, e in enumerate(errs, 1):
        print(f"\n--- #{i} ---")
        print(e[:1400])

asyncio.run(main())
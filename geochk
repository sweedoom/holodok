import asyncio, sys
from playwright.async_api import async_playwright
sys.stdout.reconfigure(encoding="utf-8")

async def main():
    async with async_playwright() as p:
        b = await p.chromium.launch()
        pg = await b.new_page(viewport={"width": 1440, "height": 900})
        await pg.goto("http://linar.me/holodok/", wait_until="domcontentloaded", timeout=60000)
        await pg.wait_for_timeout(3000)
        for i in range(1, 6):
            await pg.evaluate(f"window.scrollTo(0, document.body.scrollHeight*{i/5})")
            await pg.wait_for_timeout(400)
        await pg.wait_for_timeout(800)
        r = await pg.evaluate("""()=>{
          const sec = document.querySelector('section.t74-geo.t74-geo--metro');
          if(!sec) return 'NO SECTION';
          const b = sec.getBoundingClientRect();
          const cs = getComputedStyle(sec);
          const head = sec.querySelector('.t74-tabs__head');
          const panels = sec.querySelectorAll('.t74-tabs__panel');
          const visible = Array.from(panels).filter(p => p.offsetParent !== null).length;
          return {
            rect:[Math.round(b.width),Math.round(b.height),Math.round(b.top+window.scrollY)],
            display:cs.display, visibility:cs.visibility, overflow:cs.overflow,
            headRect: head? [Math.round(head.getBoundingClientRect().width), Math.round(head.getBoundingClientRect().height)] : null,
            panels: panels.length,
            visiblePanels: visible,
            h2: sec.querySelector('h2')?.innerText
          };
        }""")
        print("metro section:", r)
        # и districts
        r2 = await pg.evaluate("""()=>{
          const sec = document.querySelector('section.t74-geo.t74-geo--districts');
          if(!sec) return 'NO';
          const b=sec.getBoundingClientRect();
          return [Math.round(b.width),Math.round(b.height),Math.round(b.top+window.scrollY), sec.querySelector('h2')?.innerText];
        }""")
        print("districts section:", r2)
        r3 = await pg.evaluate("""()=>{
          const sec = document.querySelector('section.t74-geo.t74-geo--suburb');
          if(!sec) return 'NO';
          const b=sec.getBoundingClientRect();
          return [Math.round(b.width),Math.round(b.height),Math.round(b.top+window.scrollY), sec.querySelector('h2')?.innerText];
        }""")
        print("suburb section:", r3)
        await b.close()

asyncio.run(main())